NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 正式環境固定使用的網站網址；未填時 production 會使用 https://my-film-manager.vercel.app
NEXT_PUBLIC_SITE_URL=https://my-film-manager.vercel.app
# Google provider 設定完成並驗證既有帳號 UUID 後才啟用。
AUTH_GOOGLE_ENABLED=false
AUTH_OWNER_ID=
SUPABASE_SECRET_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
CRON_SECRET=
# 供獨立排程唯讀查核備份；與 CRON_SECRET 使用不同值。
BACKUP_MONITOR_SECRET=
# 逾期通知（可選；需先在 Resend 驗證寄件網域）
RESEND_API_KEY=
RESEND_FROM=
OVERDUE_NOTIFICATION_TO=
# 為避免多帳號資料混寄，請填要通知的 owner UUID
OVERDUE_NOTIFICATION_OWNER_ID=
